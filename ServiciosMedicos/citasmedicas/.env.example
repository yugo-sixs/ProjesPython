# Django en Windows conectado al MySQL local (configuración actual del proyecto)
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-private-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=db_citas_hospital
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Para Django dentro de la misma red Docker, usa DB_HOST=asistencia_mysql.
# Para Django en Windows y MySQL dentro de Docker, publica el puerto del contenedor
# (por ejemplo 3307:3306) y usa DB_HOST=127.0.0.1 y DB_PORT=3307.
